# PostgreSQL - Write (Primary)
DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?sslmode=require"

# PostgreSQL - Read Replica (Optional)
DATABASE_URL_READ_REPLICA="postgresql://<db_user>:<db_password>@<read_replica_host>:5432/<db_name>?sslmode=require"

NEXT_PUBLIC_SITE_URL="https://<your-amplify-domain>"
ENABLE_CARD_AUTOCONFIRM="false"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CARD
  EFT
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum EventStatus {
  NEW
  QUOTED
  DEPOSIT_PENDING
  BOOKED
  CANCELLED
}

model Room {
  id          String                 @id @default(cuid())
  slug        String                 @unique
  name        String
  description String
  capacity    Int
  rate        Int
  image       String?
  isActive    Boolean                @default(true)
  bookings    AccommodationBooking[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model Customer {
  id                     String                  @id @default(cuid())
  fullName               String
  email                  String
  phone                  String
  notes                  String?
  accommodationBookings  AccommodationBooking[]
  diningReservations     DiningReservation[]
  eventEnquiries         EventEnquiry[]
  payments               Payment[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
}

model AccommodationBooking {
  id                 String         @id @default(cuid())
  customerId         String
  roomId             String
  checkIn            DateTime
  checkOut           DateTime
  guests             Int
  specialRequests    String?
  totalAmount        Int
  bookingStatus      BookingStatus  @default(PENDING)
  paymentStatus      PaymentStatus  @default(UNPAID)
  paymentMethod      PaymentMethod?
  confirmationCode   String         @unique
  cancellationReason String?
  customer           Customer       @relation(fields: [customerId], references: [id])
  room               Room           @relation(fields: [roomId], references: [id])
  payments           Payment[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model DiningReservation {
  id               String         @id @default(cuid())
  customerId       String
  reservedAt       DateTime
  guestCount       Int
  notes            String?
  status           BookingStatus  @default(PENDING)
  confirmationCode String         @unique
  customer         Customer       @relation(fields: [customerId], references: [id])
  payments         Payment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model EventEnquiry {
  id             String       @id @default(cuid())
  customerId     String
  eventDate      DateTime?
  guestCount     Int?
  eventType      String
  details        String
  quoteAmount    Int?
  depositAmount  Int?
  status         EventStatus  @default(NEW)
  quoteReference String?      @unique
  customer       Customer     @relation(fields: [customerId], references: [id])
  payments       Payment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Payment {
  id                      String                 @id @default(cuid())
  customerId              String
  accommodationBookingId  String?
  diningReservationId     String?
  eventEnquiryId          String?
  amount                  Int
  method                  PaymentMethod
  status                  PaymentStatus          @default(PENDING)
  reference               String                 @unique
  provider                String?
  providerReference       String?
  paidAt                  DateTime?
  refundedAt              DateTime?
  notes                   String?
  customer                Customer               @relation(fields: [customerId], references: [id])
  accommodationBooking    AccommodationBooking?  @relation(fields: [accommodationBookingId], references: [id])
  diningReservation       DiningReservation?     @relation(fields: [diningReservationId], references: [id])
  eventEnquiry            EventEnquiry?          @relation(fields: [eventEnquiryId], references: [id])
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}
